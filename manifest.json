{
  "manifest_version": 3,
  "name": "Agha Reza!",
  "version": "2.1.0",
  "description": "Agha Reza! - Top 15 Google Web Results & Heading Pattern Extractor",
  "permissions": ["tabs", "scripting", "downloads"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Agha Reza!",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  }
}